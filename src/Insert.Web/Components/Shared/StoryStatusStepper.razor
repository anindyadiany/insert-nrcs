@using System.Globalization
<div class="stepper2">
    <div class="stepper2-labels">
        @for (int i = 0; i < Steps.Count; i++)
        {
            <div class="stepper2-col">
                <span class="stepper2-label @(IsOn(i) ? "is-active" : "")">@FormatLabel(Steps[i])</span>
            </div>
        }
    </div>

    <div class="stepper2-bar">
        <div class="stepper2-fill @(IsKilled ? "is-killed" : "")" style="width:@FillPercent.ToString("0.##", CultureInfo.InvariantCulture)%"></div>
        <div class="stepper2-dots">
            @for (int i = 0; i < Steps.Count; i++)
            {
                <div class="stepper2-col">
                    <div class="stepper2-dot @(IsOn(i) ? "is-active" : "") @(i == CurrentIndex ? "is-current" : "")"></div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Status { get; set; } = "Draft";

    private static readonly List<string> Steps = new()
    {
        "Draft", "Assigned", "InProgress", "InReview", "Approved", "Published", "Killed"
    };

    private bool IsKilled => Status == "Killed";
    private int CurrentIndex => Math.Max(Steps.IndexOf(Status), 0);

    // dot i sits at the centre of its column -> (i + 0.5) / count
    private double FillPercent => (CurrentIndex + 0.5) / Steps.Count * 100d;

    private bool IsOn(int i) => IsKilled ? i == Steps.Count - 1 : i <= CurrentIndex;

    private string FormatLabel(string step) => step switch
    {
        "InProgress" => "In Progress",
        "InReview"   => "In Review",
        _            => step
    };
}