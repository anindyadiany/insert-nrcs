@using Microsoft.AspNetCore.Components.Authorization

<div class="sidebar">
    <div class="sidebar-brand">
        <img src="images/logo-insert2.svg" alt="INSERT NRCS" />
    </div>
    <nav class="sidebar-nav">
        @foreach (var item in visibleItems)
        {
            <NavLink class="sidebar-item" href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                <iconify-icon icon="@item.Icon" width="24" height="24"></iconify-icon>
                <span>@item.Label</span>
            </NavLink>
        }
        @if (isAuthenticated)
        {
            <form action="Account/Logout" method="post" class="logout-form">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="" />
                <button type="submit" class="sidebar-item sidebar-item-button">
                    <iconify-icon icon="mdi:logout" width="24" height="24"></iconify-icon>
                    <span>Logout</span>
                </button>
            </form>
        }
    </nav>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool isAuthenticated;
    private List<NavItem> visibleItems = new();

    private static readonly List<NavItem> AllItems = new()
    {
        new("Dashboard", "mdi:view-dashboard", "", null),
        new("Stories", "mdi:file-document-multiple", "stories", new[] { "Reporter", "Producer", "AssignmentDesk" }),
        new("Assignment", "mdi:clipboard-text", "assignments", new[] { "Reporter", "Producer", "AssignmentDesk" }),
        new("Rundown", "mdi:playlist-check", "rundown", new[] { "Producer" }),
        new("Ingest", "mdi:tray-arrow-up", "ingest", new[] { "Reporter", "IngestOperator", "AssignmentDesk" }),
    };

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState!).User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;

        visibleItems = isAuthenticated
            ? AllItems.Where(i => i.Roles is null || i.Roles.Any(user.IsInRole)).ToList()
            : new List<NavItem>();
    }

    private record NavItem(string Label, string Icon, string Href, string[]? Roles);
}