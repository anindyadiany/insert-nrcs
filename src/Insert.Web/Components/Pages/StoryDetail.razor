@page "/stories/{id:guid}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Insert.Application.Stories
@using Insert.Domain.Entities
@using Insert.Web.Components.Shared
@using System.Security.Claims
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Reporter,Producer,AssignmentDesk")]
@implements IDisposable
@inject StoryService StoryService
@inject AssignmentService AssignmentService
@inject StoryWorkflowService WorkflowService
@inject IngestService IngestService
@inject ScriptService ScriptService
@inject ApprovalService ApprovalService

<PageTitle>@(story?.Title ?? "Story") - INSERT NRCS</PageTitle>

<div class="story-page">
    @if (story is null)
    {
        <p class="loading">Loading...</p>
    }
    else
    {
        <div class="story-header">
            <div class="story-heading">
                <a href="/stories" class="back-link">
                    <iconify-icon icon="mdi:arrow-left" width="18" height="18"></iconify-icon>
                    Stories
                </a>
                <h1 class="story-title">@story.Title</h1>
            </div>

            @if (primaryNextStatus is not null)
            {
                <div class="story-header-actions">
                    <button class="btn-primary" @onclick="() => ChangeStatus(primaryNextStatus.Value)">
                        Move to @FormatStatus(primaryNextStatus.Value)
                    </button>
                    @if (canKill)
                    {
                        <button class="btn-text btn-kill" @onclick="() => ChangeStatus(StoryStatus.Killed)">
                            Kill story
                        </button>
                    }
                </div>
            }
        </div>

        <div class="stepper-wrap">
            <StoryStatusStepper Status="@story.Status.ToString()" />
        </div>

        @if (LatestRevisionRequest is not null)
        {
            <div class="revision-alert">
                <div class="revision-alert-head">
                    <iconify-icon icon="mdi:arrow-u-left-top" width="18" height="18"></iconify-icon>
                    <span class="revision-label">Revision Requested</span>
                    <span class="revision-date">@LatestRevisionRequest.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                </div>
                <p class="revision-comment">@LatestRevisionRequest.Comment</p>
            </div>
        }

        <div class="detail-grid">
            <!-- ===== Detail ===== -->
            <div class="card">
                <div class="card-head">
                    <h5 class="card-title">Detail</h5>

                    @if (editDetail)
                    {
                        <div class="head-actions">
                            <button class="btn-text" @onclick="CancelDetail">Cancel</button>
                            <button class="btn-save" @onclick="SaveDetail">Save</button>
                        </div>
                    }
                    else
                    {
                        <button class="icon-btn" title="Edit detail" @onclick="StartEditDetail">
                            <iconify-icon icon="mdi:pencil-outline" width="18" height="18"></iconify-icon>
                        </button>
                    }
                </div>

                <div class="card-scroll">
                    @if (editDetail)
                    {
                        <div class="form-stack">
                            <div class="field-group">
                                <label>Title</label>
                                <input class="field-input" @bind="draft.Title" />
                            </div>
                            <div class="field-row">
                                <div class="field-group">
                                    <label>Category</label>
                                    <input class="field-input" @bind="draft.Category" />
                                </div>
                                <div class="field-group">
                                    <label>Program</label>
                                    <input class="field-input" @bind="draft.Program" />
                                </div>
                            </div>
                            <div class="field-group">
                                <label>Priority</label>
                                <select class="field-input" @bind="draft.Priority">
                                    @foreach (var p in Enum.GetValues<StoryPriority>())
                                    {
                                        <option value="@p">@p</option>
                                    }
                                </select>
                            </div>
                            <div class="field-group">
                                <label>Deadline</label>
                                <input type="datetime-local" class="field-input"
                                    value="@ToInputValue(draft.Deadline)"
                                    @onchange="OnStoryDeadlineChanged" />
                            </div>
                            <div class="field-group">
                                <label>Notes</label>
                                <textarea class="field-input" rows="3" @bind="draft.Notes"></textarea>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">Status</span>
                                <span class="chip @ChipClass(story.Status)">@story.Status</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Priority</span>
                                <span class="chip @PriorityClass(story.Priority)">@story.Priority</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Category</span>
                                <span class="info-value">@Show(story.Category)</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Program</span>
                                <span class="info-value">@Show(story.Program)</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Deadline</span>
                                <span class="info-value">@(story.Deadline?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Notes</span>
                                <span class="info-value">@Show(story.Notes)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ===== Assignments ===== -->
            <div class="card">
                <div class="card-head">
                    <h5 class="card-title">Assignments</h5>

                    @if (assignment is not null)
                    {
                        <button class="icon-btn" title="Edit assignment" @onclick="StartEditAssign">
                            <iconify-icon icon="mdi:pencil-outline" width="18" height="18"></iconify-icon>
                        </button>
                    }
                </div>

                <div class="card-scroll">
                    @if (assignment is not null)
                    {
                        <ul class="assignment-list">
                            <li class="assignment-row" @onclick="StartEditAssign" style="cursor:pointer">
                                <div class="assignment-info">
                                    <span class="assignment-name">@Show(assignment.Location, "Assignment")</span>
                                    <span class="assignment-meta">@Show(assignment.Brief, "Tidak ada brief")</span>
                                    <span class="assignment-meta">Deadline: @(assignment.Deadline?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                                </div>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <div class="empty-state">
                            <p class="empty-text">Belum ada assignment untuk story ini.</p>
                            <button class="btn-outline" @onclick="StartEditAssign">+ Create Assignment</button>
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- ===== Media ===== -->
        <div class="card script-card">
            <div class="media-layout">
                <div class="media-form">
                    <h5 class="card-title media-col-title">Media</h5>
                    <select class="field-input" @bind="selectedAssetId">
                        <option value="">Choose Media</option>
                        @foreach (var asset in availableAssets)
                        {
                            <option value="@asset.Id">@asset.OriginalFilename</option>
                        }
                    </select>
                    <input class="field-input" @bind="mediaRoleInput" placeholder="Role (interview, b-roll, standup...)" />
                    <button class="btn-outline" @onclick="AttachMedia">+ Attach Media</button>
                </div>

                <div class="media-preview">
                    <h5 class="card-title media-col-title">Preview</h5>
                    @if (storyMedia.Any())
                    {
                        <div class="story-media-grid">
                            @foreach (var link in storyMedia)
                            {
                                var asset = attachedAssets.FirstOrDefault(a => a.Id == link.MediaAssetId);
                                <div class="story-media-item">
                                    <div class="story-media-thumb">
                                        @if (asset?.ThumbnailPath is not null)
                                        {
                                            <img src="/media-thumbnail/@asset.Id" alt="@asset.OriginalFilename" />
                                        }
                                        @if (asset?.DurationSeconds is not null)
                                        {
                                            <span class="story-media-duration">@FormatDuration(asset.DurationSeconds.Value)</span>
                                        }
                                    </div>
                                    <div class="story-media-info">
                                        @if (!string.IsNullOrWhiteSpace(link.Role))
                                        {
                                            <span class="story-media-role">@link.Role</span>
                                        }
                                        <p class="story-media-filename" title="@asset?.OriginalFilename">@asset?.OriginalFilename</p>
                                        <p class="story-media-meta">
                                            @(asset?.Resolution ?? "-") &middot; @FormatSize(asset?.FileSize ?? 0)
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="empty-text">Belum ada media untuk story ini.</p>
                    }
                </div>
            </div>
        </div>

        <AuthorizeView Roles="Producer" Context="approvalCtx">
    @if (story.Status == StoryStatus.InReview)
    {
        <div class="card">
            <div class="card-head">
                <h5 class="card-title">Review</h5>
            </div>

            <div class="form-stack">
                <div class="field-group">
                    <label>Comment</label>
                    <textarea class="field-input" rows="3" @bind="approvalComment"
                              placeholder="Note for reporter (optional for approve, required for revision/reject)"></textarea>
                    @if (approvalError is not null)
                    {
                        <span class="field-error">@approvalError</span>
                    }
                </div>
                <div class="approval-actions">
                    <button class="btn-primary" @onclick="() => SubmitDecision(ApprovalDecision.Approved)">
                        Approve
                    </button>
                    <button class="btn-outline" @onclick="() => SubmitDecision(ApprovalDecision.Rejected)">
                        Reject
                    </button>
                </div>
            </div>
        </div>
    }
</AuthorizeView>

@if (approvalHistory.Any())
{
    <div class="card">
        <div class="card-head">
            <h5 class="card-title">Review History</h5>
        </div>
        <div class="approval-history">
            @foreach (var a in approvalHistory)
            {
                <div class="approval-item">
                    <div class="approval-head">
                        <span class="chip @DecisionChipClass(a.Decision)">@FormatDecision(a.Decision)</span>
                        <span class="version-date">@a.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(a.Comment))
                    {
                        <p class="approval-comment">@a.Comment</p>
                    }
                </div>
            }
        </div>
    </div>
}

        @if (editAssign)
        {
            <div class="modal-overlay" @onclick="CancelAssign">
                <div class="modal-box" @onclick:stopPropagation="true">
                    <div class="modal-head">
                        <h5 class="card-title">@(assignment is null ? "New Assignment" : "Edit Assignment")</h5>
                        <button class="icon-btn" @onclick="CancelAssign">
                            <iconify-icon icon="mdi:close" width="20" height="20"></iconify-icon>
                        </button>
                    </div>

                    <div class="form-stack">
                        <div class="field-group">
                            <label>Reporter</label>
                            <select class="field-input" @bind="reporterIdInput">
                                <option value="">-- pilih reporter --</option>
                                @foreach (var r in reporters)
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            </select>
                            @if (reporterIdError)
                            {
                                <span class="field-error">Pilih salah satu reporter.</span>
                            }
                        </div>
                        <div class="field-group">
                            <label>Location</label>
                            <input class="field-input" @bind="newAssignment.Location" />
                        </div>
                        <div class="field-group">
                            <label>Event</label>
                            <input class="field-input" @bind="newAssignment.Event" />
                        </div>
                        <div class="field-group">
                            <label>Deadline</label>
                            <input type="datetime-local" class="field-input"
                                   value="@ToInputValue(newAssignment.Deadline)"
                                   @onchange="OnDeadlineChanged" />
                        </div>
                        <div class="field-group">
                            <label>Brief</label>
                            <textarea class="field-input" rows="4" @bind="newAssignment.Brief"></textarea>
                        </div>
                        <div class="field-group">
                            <label>Notes</label>
                            <textarea class="field-input" rows="2" @bind="newAssignment.Notes"></textarea>
                        </div>

                        <div class="form-actions">
                            <button class="btn-primary" @onclick="SaveAssignment">Save</button>
                            <button class="btn-text" @onclick="CancelAssign">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ===== Script ===== -->
        <div class="card script-card">
            <div class="card-head">
                <h5 class="card-title">Script</h5>
                <div class="head-actions">
                    <span class="autosave-status">@autosaveStatus</span>
                    <button class="btn-text" @onclick="() => showVersions = !showVersions">
                        Versions (@(scriptSummary?.Versions.Count ?? 0))
                    </button>
                    <button class="btn-save" @onclick="SaveVersion" disabled="@(!CanSaveVersion)">Save Version</button>
                </div>
            </div>

            <div class="script-meta-row">
                <span>@liveWordCount kata</span>
                <span>&middot;</span>
                <span>est. @FormatDuration(ScriptService.EstimateSeconds(liveWordCount))</span>
            </div>

            <div class="script-body-wrap">
<textarea class="field-input script-input"
          value="@scriptDraft"
          @oninput="OnScriptInput"
          placeholder="SLUG: PUBLIC TRANSPORT&#10;DATE: 21 AUGUST 2026&#10;DURATION: 01:30&#10;&#10;ANCHOR INTRO&#10;The government has announced a new program...&#10;&#10;VO - OVER B-ROLL&#10;The transportation ministry says...&#10;&#10;SOT - ARDI PRATAMA / TRANSPORTATION OFFICIAL&#10;&quot;We want public transportation to become...&quot;"></textarea>

            @if (selectedVersion is not null)
            {
                <div class="version-viewer">
                    <div class="version-viewer-head">
                        <span class="version-number">v@(selectedVersion.VersionNumber)</span>
                        <div class="head-actions">
                            <button class="btn-text" @onclick="RestoreVersion">Restore this Version</button>
                            <button class="icon-btn" @onclick="() => selectedVersion = null">
                                <iconify-icon icon="mdi:close" width="18" height="18"></iconify-icon>
                            </button>
                        </div>
                    </div>
                    <pre class="version-content">@selectedVersion.Content</pre>
                </div>
            }

                @if (showVersions)
                {
                    <div class="version-list">
                        <p class="version-list-title">Version History</p>
                        @if (scriptSummary?.Versions.Any() == true)
                        {
                           @foreach (var v in scriptSummary.Versions)
                                {
                                    <div class="version-item @(selectedVersionId == v.Id ? "is-selected" : "")"
                                        @onclick="() => SelectVersion(v)">
                                        <div class="version-head">
                                            <span class="version-number">v@(v.VersionNumber)</span>
                                            <span class="version-date">@v.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                        </div>
                                        <p class="version-meta">
                                            @v.WordCount kata &middot; @FormatDuration(v.EstimatedDurationSeconds)
                                        </p>
                                        @if (!string.IsNullOrWhiteSpace(v.ChangeNote))
                                        {
                                            <p class="version-note">@v.ChangeNote</p>
                                        }
                                    </div>
                                }
                        }
                        else
                        {
                            <p class="empty-text">Belum ada versi tersimpan.</p>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>



@code {
    
    [Parameter] public Guid Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Story? story;
    private Assignment? assignment;
    private List<UserSummary> reporters = new();

    private List<StoryMedia> storyMedia = new();
    private List<MediaAsset> availableAssets = new();
    private List<MediaAsset> attachedAssets = new();
    private string selectedAssetId = "";
    private string mediaRoleInput = "";

    private ScriptSummary? scriptSummary;
    private string scriptDraft = "";
    private int liveWordCount;
    private string autosaveStatus = "";
    private bool showVersions;
    private CancellationTokenSource? autosaveCts;

    private ScriptVersion? selectedVersion;
private Guid? selectedVersionId => selectedVersion?.Id;

private void SelectVersion(ScriptVersion version) =>
    selectedVersion = selectedVersion?.Id == version.Id ? null : version;

private async Task RestoreVersion()
{
    if (selectedVersion is null) return;

    var userId = await GetCurrentUserIdAsync();
    if (userId is null) return;

    scriptDraft = selectedVersion.Content;
    liveWordCount = ScriptService.CountWords(scriptDraft);
    await ScriptService.SaveDraftAsync(Id, scriptDraft, userId.Value);
    autosaveStatus = $"Dipulihkan dari v{selectedVersion.VersionNumber}";
    selectedVersion = null;
}

    private static readonly Dictionary<StoryStatus, StoryStatus> PrimaryNext = new()
    {
        [StoryStatus.Draft] = StoryStatus.Assigned,
        [StoryStatus.Assigned] = StoryStatus.InProgress,
        [StoryStatus.InProgress] = StoryStatus.InReview,
        [StoryStatus.InReview] = StoryStatus.Approved,
        [StoryStatus.Approved] = StoryStatus.Published,
    };

    private StoryStatus? primaryNextStatus;
    private bool canKill;

    private bool editDetail, editAssign;
    private bool reporterIdError;

    private UpdateStoryRequest draft = new();
    private CreateAssignmentRequest newAssignment = new();
    private string reporterIdInput = "";

    protected override async Task OnInitializedAsync()
    {
        story = await StoryService.GetStoryByIdAsync(Id);
        assignment = await AssignmentService.GetAssignmentForStoryAsync(Id);
        reporters = await AssignmentService.GetReportersAsync();
        RefreshNextStatuses();

        storyMedia = await IngestService.GetStoryMediaAsync(Id);
        availableAssets = await IngestService.GetAvailableAssetsAsync();
        attachedAssets = await IngestService.GetAssetsByIdsAsync(storyMedia.Select(sm => sm.MediaAssetId).ToList());
        approvalHistory = await ApprovalService.GetHistoryAsync(Id);

        await LoadScript();
    }

private void RefreshNextStatuses()
{
    primaryNextStatus = PrimaryNext.TryGetValue(story!.Status, out var next) ? next : null;

    // InReview → Approved must go through the approval card, not the shortcut button
    if (story.Status == StoryStatus.InReview) primaryNextStatus = null;

    canKill = WorkflowService.CanTransition(story.Status, StoryStatus.Killed);
}

    private async Task ChangeStatus(StoryStatus newStatus)
    {
        var userId = await GetCurrentUserIdAsync();
        if (userId is null) return;

        await StoryService.ChangeStatusAsync(story!.Id, newStatus, userId.Value);
        story = await StoryService.GetStoryByIdAsync(Id);
        RefreshNextStatuses();
    }

    // ----- Detail -----
    private void StartEditDetail()
    {
        draft = new UpdateStoryRequest
        {
            Title = story!.Title,
            Category = story.Category,
            Program = story.Program,
            Priority = story.Priority,
            Deadline = story.Deadline,
            Notes = story.Notes
        };
        editDetail = true;
    }

    private void CancelDetail() => editDetail = false;

    private async Task SaveDetail()
    {
        await StoryService.UpdateStoryAsync(Id, draft);
        story = await StoryService.GetStoryByIdAsync(Id);
        editDetail = false;
    }

    private void OnStoryDeadlineChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsed))
            draft.Deadline = parsed;
        else
            draft.Deadline = null;
    }

    // ----- Assignment -----
    private void StartEditAssign()
    {
        if (assignment is not null)
        {
            reporterIdInput = assignment.ReporterId.ToString();
            newAssignment = new CreateAssignmentRequest
            {
                Location = assignment.Location,
                Event = assignment.Event,
                Deadline = assignment.Deadline,
                Brief = assignment.Brief,
                Notes = assignment.Notes
            };
        }
        else
        {
            reporterIdInput = "";
            newAssignment = new CreateAssignmentRequest();
        }
        editAssign = true;
    }

    private void CancelAssign()
    {
        reporterIdError = false;
        editAssign = false;
    }

    private async Task SaveAssignment()
    {
        if (!Guid.TryParse(reporterIdInput, out var reporterId))
        {
            reporterIdError = true;
            return;
        }

        reporterIdError = false;

        if (assignment is not null)
        {
            await AssignmentService.UpdateAssignmentAsync(assignment.Id, new UpdateAssignmentRequest
            {
                ReporterId = reporterId,
                Location = newAssignment.Location,
                Event = newAssignment.Event,
                Deadline = newAssignment.Deadline,
                Brief = newAssignment.Brief,
                Notes = newAssignment.Notes
            });
        }
        else
        {
            newAssignment.StoryId = Id;
            newAssignment.ReporterId = reporterId;
            await AssignmentService.CreateAssignmentAsync(newAssignment);
        }

        assignment = await AssignmentService.GetAssignmentForStoryAsync(Id);
        story = await StoryService.GetStoryByIdAsync(Id);
        editAssign = false;
    }

    private void OnDeadlineChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsed))
            newAssignment.Deadline = parsed;
        else
            newAssignment.Deadline = null;
    }

    // ----- Media -----
    private async Task AttachMedia()
    {
        if (!Guid.TryParse(selectedAssetId, out var assetId)) return;
        await IngestService.AttachMediaToStoryAsync(Id, assetId, mediaRoleInput);
        storyMedia = await IngestService.GetStoryMediaAsync(Id);
        availableAssets = await IngestService.GetAvailableAssetsAsync();
        attachedAssets = await IngestService.GetAssetsByIdsAsync(storyMedia.Select(sm => sm.MediaAssetId).ToList());
        selectedAssetId = "";
        mediaRoleInput = "";
    }

    // ----- Script -----
    private bool CanSaveVersion => !string.IsNullOrWhiteSpace(scriptDraft);

    private async Task LoadScript()
    {
        scriptSummary = await ScriptService.GetForStoryAsync(Id);
        scriptDraft = scriptSummary.Script?.Content ?? "";
        liveWordCount = ScriptService.CountWords(scriptDraft);
    }

    private void OnScriptInput(ChangeEventArgs e)
    {
        scriptDraft = e.Value?.ToString() ?? "";
        liveWordCount = ScriptService.CountWords(scriptDraft);
        autosaveStatus = "Mengetik...";

        autosaveCts?.Cancel();
        autosaveCts = new CancellationTokenSource();
        var token = autosaveCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(1500, token);
                await AutosaveAsync();
            }
            catch (TaskCanceledException) { }
            catch (Exception ex)
            {
                Console.WriteLine($"[Script autosave] failed: {ex}");
            }
        });
    }

    private async Task AutosaveAsync()
    {
        var userId = await GetCurrentUserIdAsync();
        if (userId is null) return;

        await ScriptService.SaveDraftAsync(Id, scriptDraft, userId.Value);
        autosaveStatus = $"Tersimpan {DateTime.Now:HH:mm:ss}";
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveVersion()
    {
        var userId = await GetCurrentUserIdAsync();
        if (userId is null) return;

        await ScriptService.SaveDraftAsync(Id, scriptDraft, userId.Value);
        await ScriptService.SaveVersionAsync(Id, userId.Value);
        await LoadScript();
        autosaveStatus = "Versi tersimpan";
        showVersions = true;
    }

    // ----- Helpers -----
    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var user = (await AuthState!).User;
        var idClaim = user.FindFirstValue(ClaimTypes.NameIdentifier);
        return Guid.TryParse(idClaim, out var userId) ? userId : null;
    }

    private static string Show(string? value, string fallback = "-") =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string FormatStatus(StoryStatus status) => status switch
    {
        StoryStatus.InProgress => "In Progress",
        StoryStatus.InReview => "In Review",
        _ => status.ToString()
    };

    private static string ToInputValue(DateTime? dt) =>
        dt is null ? "" :
        $"{dt.Value.Year:D4}-{dt.Value.Month:D2}-{dt.Value.Day:D2}T{dt.Value.Hour:D2}:{dt.Value.Minute:D2}";

    private static string FormatDuration(int seconds) =>
        $"{seconds / 60}:{seconds % 60:D2}";

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:0.#} GB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:0.#} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes} B";
    }

    private string ChipClass(StoryStatus status) => status switch
    {
        StoryStatus.Draft => "chip-draft",
        StoryStatus.InReview => "chip-review",
        StoryStatus.Approved => "chip-approved",
        StoryStatus.Published => "chip-published",
        StoryStatus.Killed => "chip-killed",
        _ => "chip-assigned"
    };

    private string PriorityClass(StoryPriority priority) => priority switch
    {
        StoryPriority.Breaking => "chip-breaking",
        StoryPriority.Urgent => "chip-urgent",
        StoryPriority.High => "chip-high",
        _ => "chip-normal"
    };

    public void Dispose() => autosaveCts?.Cancel();

    private List<Approval> approvalHistory = new();
    private string approvalComment = "";
    private string? approvalError;

    private async Task SubmitDecision(ApprovalDecision decision)
    {
        approvalError = null;

        // comment required when sending back or killing — the reporter needs to know why
        if (decision != ApprovalDecision.Approved && string.IsNullOrWhiteSpace(approvalComment))
        {
            approvalError = "Komentar wajib diisi untuk revisi atau reject.";
            return;
        }

        var userId = await GetCurrentUserIdAsync();
        if (userId is null) return;

        await ApprovalService.SubmitDecisionAsync(Id, userId.Value, decision, approvalComment);

        approvalComment = "";
        story = await StoryService.GetStoryByIdAsync(Id);
        approvalHistory = await ApprovalService.GetHistoryAsync(Id);
        RefreshNextStatuses();
    }

    private static string FormatDecision(ApprovalDecision d) => d switch
    {
        ApprovalDecision.Approved => "Approved",
        ApprovalDecision.Rejected => "Revision Requested",
        _ => "Pending"
    };

    private static string DecisionChipClass(ApprovalDecision d) => d switch
    {
        ApprovalDecision.Approved => "chip-approved",
        ApprovalDecision.ChangesRequested => "chip-review",
        ApprovalDecision.Rejected => "chip-killed",
        _ => "chip-draft"
    };

    private Approval? LatestRevisionRequest =>
        story?.Status == StoryStatus.InProgress
        && approvalHistory.FirstOrDefault() is { Decision: ApprovalDecision.Rejected } latest
            ? latest
            : null;
}