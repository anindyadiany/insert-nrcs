@page "/stories/{id:guid}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Insert.Application.Stories
@using Insert.Domain.Entities
@using Insert.Web.Components.Shared
@using System.Security.Claims
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Reporter,Producer,AssignmentDesk")]
@inject StoryService StoryService
@inject AssignmentService AssignmentService
@inject StoryWorkflowService WorkflowService
@inject IngestService IngestService

<PageTitle>@(story?.Title ?? "Story") - INSERT NRCS</PageTitle>

<div class="story-page">
    @if (story is null)
    {
        <p class="loading">Loading...</p>
    }
    else
    {
        <div class="story-header">
            <div class="story-heading">
                <a href="/stories" class="back-link">
                    <iconify-icon icon="mdi:arrow-left" width="18" height="18"></iconify-icon>
                    Stories
                </a>
                <h1 class="story-title">@story.Title</h1>
            </div>

            @if (primaryNextStatus is not null)
            {
                <div class="story-header-actions">
                    <button class="btn-primary" @onclick="() => ChangeStatus(primaryNextStatus.Value)">
                        Move to @FormatStatus(primaryNextStatus.Value)
                    </button>
                    @if (canKill)
                    {
                        <button class="btn-text btn-kill" @onclick="() => ChangeStatus(StoryStatus.Killed)">
                            Kill story
                        </button>
                    }
                </div>
            }
        </div>

        <div class="stepper-wrap">
            <StoryStatusStepper Status="@story.Status.ToString()" />
        </div>

        <div class="detail-grid">
            <!-- ===== Detail ===== -->
            <div class="card">
                <div class="card-head">
                    <h5 class="card-title">Detail</h5>

                    @if (editDetail)
                    {
                        <div class="head-actions">
                            <button class="btn-text" @onclick="CancelDetail">Cancel</button>
                            <button class="btn-save" @onclick="SaveDetail">Save</button>
                        </div>
                    }
                    else
                    {
                        <button class="icon-btn" title="Edit detail" @onclick="StartEditDetail">
                            <iconify-icon icon="mdi:pencil-outline" width="18" height="18"></iconify-icon>
                        </button>
                    }
                </div>

                <div class="card-scroll">
                    @if (editDetail)
                    {
                        <div class="form-stack">
                            <div class="field-group">
                                <label>Title</label>
                                <input class="field-input" @bind="draft.Title" />
                            </div>
                            <div class="field-row">
                                <div class="field-group">
                                    <label>Category</label>
                                    <input class="field-input" @bind="draft.Category" />
                                </div>
                                <div class="field-group">
                                    <label>Program</label>
                                    <input class="field-input" @bind="draft.Program" />
                                </div>
                            </div>
                            <div class="field-group">
                                <label>Priority</label>
                                <select class="field-input" @bind="draft.Priority">
                                    @foreach (var p in Enum.GetValues<StoryPriority>())
                                    {
                                        <option value="@p">@p</option>
                                    }
                                </select>
                            </div>
                            <div class="field-group">
                                <label>Deadline</label>
                                <input type="datetime-local" class="field-input"
                                    value="@ToInputValue(draft.Deadline)"
                                    @onchange="OnStoryDeadlineChanged" />
                            </div>
                            <div class="field-group">
                                <label>Notes</label>
                                <textarea class="field-input" rows="3" @bind="draft.Notes"></textarea>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">Status</span>
                                <span class="chip @ChipClass(story.Status)">@story.Status</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Priority</span>
                                <span class="chip @PriorityClass(story.Priority)">@story.Priority</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Category</span>
                                <span class="info-value">@Show(story.Category)</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Program</span>
                                <span class="info-value">@Show(story.Program)</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Deadline</span>
                                <span class="info-value">@(story.Deadline?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Notes</span>
                                <span class="info-value">@Show(story.Notes)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ===== Assignments ===== -->
            <div class="card">
                <div class="card-head">
                    <h5 class="card-title">Assignments</h5>

                    @if (assignment is not null)
                    {
                        <button class="icon-btn" title="Edit assignment" @onclick="StartEditAssign">
                            <iconify-icon icon="mdi:pencil-outline" width="18" height="18"></iconify-icon>
                        </button>
                    }
                </div>

                <div class="card-scroll">
                    @if (assignment is not null)
                    {
                        <ul class="assignment-list">
                            <li class="assignment-row" @onclick="StartEditAssign" style="cursor:pointer">
                                <div class="assignment-info">
                                    <span class="assignment-name">@Show(assignment.Location, "Assignment")</span>
                                    <span class="assignment-meta">@Show(assignment.Brief, "Tidak ada brief")</span>
                                    <span class="assignment-meta">Deadline: @(assignment.Deadline?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                                </div>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <div class="empty-state">
                            <p class="empty-text">Belum ada assignment untuk story ini.</p>
                            <button class="btn-outline" @onclick="StartEditAssign">+ Create Assignment</button>
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- ===== Media ===== -->
        <div class="card script-card">
            <div class="media-layout">
                <div class="media-form">
                    <h5 class="card-title media-col-title">Media</h5>
                    <select class="field-input" @bind="selectedAssetId">
                        <option value="">-- pilih media Ready --</option>
                        @foreach (var asset in availableAssets)
                        {
                            <option value="@asset.Id">@asset.OriginalFilename</option>
                        }
                    </select>
                    <input class="field-input" @bind="mediaRoleInput" placeholder="Role (interview, b-roll, standup...)" />
                    <button class="btn-outline" @onclick="AttachMedia">+ Attach Media</button>
                </div>

                <div class="media-preview">
                    <h5 class="card-title media-col-title">Preview</h5>
                    @if (storyMedia.Any())
                    {
                        <div class="story-media-grid">
                            @foreach (var link in storyMedia)
                            {
                                var asset = attachedAssets.FirstOrDefault(a => a.Id == link.MediaAssetId);
                                <div class="story-media-thumb">
                                    @if (asset?.ThumbnailPath is not null)
                                    {
                                        <img src="/media-thumbnail/@asset.Id" alt="@asset.OriginalFilename" />
                                    }
                                    <p class="story-media-caption">@(link.Role ?? asset?.OriginalFilename)</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="empty-text">Belum ada media untuk story ini.</p>
                    }
                </div>
            </div>
        </div>

        @if (editAssign)
        {
            <div class="modal-overlay" @onclick="CancelAssign">
                <div class="modal-box" @onclick:stopPropagation="true">
                    <div class="modal-head">
                        <h5 class="card-title">@(assignment is null ? "New Assignment" : "Edit Assignment")</h5>
                        <button class="icon-btn" @onclick="CancelAssign">
                            <iconify-icon icon="mdi:close" width="20" height="20"></iconify-icon>
                        </button>
                    </div>

                    <div class="form-stack">
                        <div class="field-group">
                            <label>Reporter</label>
                            <select class="field-input" @bind="reporterIdInput">
                                <option value="">-- pilih reporter --</option>
                                @foreach (var r in reporters)
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            </select>
                            @if (reporterIdError)
                            {
                                <span class="field-error">Pilih salah satu reporter.</span>
                            }
                        </div>
                        <div class="field-group">
                            <label>Location</label>
                            <input class="field-input" @bind="newAssignment.Location" />
                        </div>
                        <div class="field-group">
                            <label>Event</label>
                            <input class="field-input" @bind="newAssignment.Event" />
                        </div>
                        <div class="field-group">
                            <label>Deadline</label>
                            <input type="datetime-local" class="field-input"
                                   value="@ToInputValue(newAssignment.Deadline)"
                                   @onchange="OnDeadlineChanged" />
                        </div>
                        <div class="field-group">
                            <label>Brief</label>
                            <textarea class="field-input" rows="4" @bind="newAssignment.Brief"></textarea>
                        </div>
                        <div class="field-group">
                            <label>Notes</label>
                            <textarea class="field-input" rows="2" @bind="newAssignment.Notes"></textarea>
                        </div>

                        <div class="form-actions">
                            <button class="btn-primary" @onclick="SaveAssignment">Save</button>
                            <button class="btn-text" @onclick="CancelAssign">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ===== Script ===== -->
        <div class="card script-card">
            <div class="card-head">
                <h5 class="card-title">Script</h5>

                @if (editScript)
                {
                    <div class="head-actions">
                        <button class="btn-text" @onclick="() => editScript = false">Cancel</button>
                        <button class="btn-save" @onclick="SaveScript">Save</button>
                    </div>
                }
                else
                {
                    <button class="icon-btn" title="Edit script" @onclick="StartEditScript">
                        <iconify-icon icon="mdi:pencil-outline" width="18" height="18"></iconify-icon>
                    </button>
                }
            </div>

            <div class="card-scroll">
                @if (editScript)
                {
                    <textarea class="field-input script-input" @bind="scriptDraft"
                              placeholder="[ANCHOR - lead-in] ..."></textarea>
                }
                else if (!string.IsNullOrWhiteSpace(scriptText))
                {
                    <pre class="script-body">@scriptText</pre>
                }
                else
                {
                    <p class="empty-text">Belum ada script untuk story ini.</p>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private Story? story;
    private Assignment? assignment;
    private List<UserSummary> reporters = new();

    private List<StoryMedia> storyMedia = new();
    private List<MediaAsset> availableAssets = new();
    private List<MediaAsset> attachedAssets = new();
    private string selectedAssetId = "";
    private string mediaRoleInput = "";

    private static readonly Dictionary<StoryStatus, StoryStatus> PrimaryNext = new()
    {
        [StoryStatus.Draft] = StoryStatus.Assigned,
        [StoryStatus.Assigned] = StoryStatus.InProgress,
        [StoryStatus.InProgress] = StoryStatus.InReview,
        [StoryStatus.InReview] = StoryStatus.Approved,
        [StoryStatus.Approved] = StoryStatus.Published,
    };

    private StoryStatus? primaryNextStatus;
    private bool canKill;

    private bool editDetail, editAssign, editScript;
    private bool reporterIdError;

    private UpdateStoryRequest draft = new();
    private CreateAssignmentRequest newAssignment = new();
    private string reporterIdInput = "";
    private string scriptText = "";
    private string scriptDraft = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        story = await StoryService.GetStoryByIdAsync(Id);
        assignment = await AssignmentService.GetAssignmentForStoryAsync(Id);
        reporters = await AssignmentService.GetReportersAsync();
        RefreshNextStatuses();

        storyMedia = await IngestService.GetStoryMediaAsync(Id);
        availableAssets = await IngestService.GetAvailableAssetsAsync();
        attachedAssets = await IngestService.GetAssetsByIdsAsync(storyMedia.Select(sm => sm.MediaAssetId).ToList());
    }

    private void RefreshNextStatuses()
    {
        primaryNextStatus = PrimaryNext.TryGetValue(story!.Status, out var next) ? next : null;
        canKill = WorkflowService.CanTransition(story.Status, StoryStatus.Killed);
    }

    private async Task ChangeStatus(StoryStatus newStatus)
    {
        var user = (await AuthState!).User;
        var idClaim = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!Guid.TryParse(idClaim, out var userId)) return;

        await StoryService.ChangeStatusAsync(story!.Id, newStatus, userId);
        story = await StoryService.GetStoryByIdAsync(Id);
        RefreshNextStatuses();
    }

    // ----- Detail -----
    private void StartEditDetail()
    {
        draft = new UpdateStoryRequest
        {
            Title = story!.Title,
            Category = story.Category,
            Program = story.Program,
            Priority = story.Priority,
            Deadline = story.Deadline,
            Notes = story.Notes
        };
        editDetail = true;
    }

    private void CancelDetail() => editDetail = false;

    private async Task SaveDetail()
    {
        await StoryService.UpdateStoryAsync(Id, draft);
        story = await StoryService.GetStoryByIdAsync(Id);
        editDetail = false;
    }

    private void OnStoryDeadlineChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsed))
            draft.Deadline = parsed;
        else
            draft.Deadline = null;
    }

    // ----- Assignment -----
    private void StartEditAssign()
    {
        if (assignment is not null)
        {
            reporterIdInput = assignment.ReporterId.ToString();
            newAssignment = new CreateAssignmentRequest
            {
                Location = assignment.Location,
                Event = assignment.Event,
                Deadline = assignment.Deadline,
                Brief = assignment.Brief,
                Notes = assignment.Notes
            };
        }
        else
        {
            reporterIdInput = "";
            newAssignment = new CreateAssignmentRequest();
        }
        editAssign = true;
    }
    private void CancelAssign()
    {
        reporterIdError = false;
        editAssign = false;
    }

    private async Task SaveAssignment()
    {
        if (!Guid.TryParse(reporterIdInput, out var reporterId))
        {
            reporterIdError = true;
            return;
        }

        reporterIdError = false;

        if (assignment is not null)
        {
            await AssignmentService.UpdateAssignmentAsync(assignment.Id, new UpdateAssignmentRequest
            {
                ReporterId = reporterId,
                Location = newAssignment.Location,
                Event = newAssignment.Event,
                Deadline = newAssignment.Deadline,
                Brief = newAssignment.Brief,
                Notes = newAssignment.Notes
            });
        }
        else
        {
            newAssignment.StoryId = Id;
            newAssignment.ReporterId = reporterId;
            await AssignmentService.CreateAssignmentAsync(newAssignment);
        }

        assignment = await AssignmentService.GetAssignmentForStoryAsync(Id);
        story = await StoryService.GetStoryByIdAsync(Id);
        editAssign = false;
    }

    private void OnDeadlineChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsed))
            newAssignment.Deadline = parsed;
        else
            newAssignment.Deadline = null;
    }

    // ----- Script -----
    private void StartEditScript()
    {
        scriptDraft = scriptText;
        editScript = true;
    }

    private void SaveScript()
    {
        scriptText = scriptDraft;
        editScript = false;
    }

    // ----- Media -----
    private async Task AttachMedia()
    {
        if (!Guid.TryParse(selectedAssetId, out var assetId)) return;
        await IngestService.AttachMediaToStoryAsync(Id, assetId, mediaRoleInput);
        storyMedia = await IngestService.GetStoryMediaAsync(Id);
        availableAssets = await IngestService.GetAvailableAssetsAsync();
        attachedAssets = await IngestService.GetAssetsByIdsAsync(storyMedia.Select(sm => sm.MediaAssetId).ToList());
        selectedAssetId = "";
        mediaRoleInput = "";
    }

    private static string Show(string? value, string fallback = "-") =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string FormatStatus(StoryStatus status) => status switch
    {
        StoryStatus.InProgress => "In Progress",
        StoryStatus.InReview => "In Review",
        _ => status.ToString()
    };

    private static string ToInputValue(DateTime? dt) =>
        dt is null ? "" :
        $"{dt.Value.Year:D4}-{dt.Value.Month:D2}-{dt.Value.Day:D2}T{dt.Value.Hour:D2}:{dt.Value.Minute:D2}";

    private string ChipClass(StoryStatus status) => status switch
    {
        StoryStatus.Draft => "chip-draft",
        StoryStatus.InReview => "chip-review",
        StoryStatus.Approved => "chip-approved",
        StoryStatus.Published => "chip-published",
        StoryStatus.Killed => "chip-killed",
        _ => "chip-assigned"
    };

    private string PriorityClass(StoryPriority priority) => priority switch
    {
        StoryPriority.Breaking => "chip-breaking",
        StoryPriority.Urgent => "chip-urgent",
        StoryPriority.High => "chip-high",
        _ => "chip-normal"
    };
}


