@page "/stories"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Insert.Application.Stories
@using Insert.Domain.Entities
@attribute [Authorize(Roles = "Reporter,Producer,AssignmentDesk")]

@inject StoryService StoryService
@inject NavigationManager Nav

<PageTitle>Stories - INSERT NRCS</PageTitle>

<div class="story-page">
    <div class="stories-header">
        <h1 class="story-title">Story</h1>
        <button class="btn-primary" @onclick="() => showForm = true">ADD NEW STORY</button>
    </div>

    @if (showForm)
    {
        <div class="card">
            <EditForm Model="newStory" OnValidSubmit="CreateStory" class="form-stack">
                <DataAnnotationsValidator />

                <div class="field-group">
                    <label>Title</label>
                    <InputText class="field-input" @bind-Value="newStory.Title" />
                    <ValidationMessage For="() => newStory.Title" />
                </div>

                <div class="field-group">
                    <label>Category</label>
                    <InputText class="field-input" @bind-Value="newStory.Category" />
                </div>

                <div class="field-group">
                    <label>Priority</label>
                    <InputSelect class="field-input" @bind-Value="newStory.Priority">
                        @foreach (var p in Enum.GetValues<StoryPriority>())
                        {
                            <option value="@p">@p</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">Create</button>
                    <button type="button" class="btn-text" @onclick="() => showForm = false">Cancel</button>
                </div>
            </EditForm>
        </div>
    }

    @if (stories is null)
    {
        <p class="loading">Loading...</p>
    }
    else if (!stories.Any())
    {
        <div class="card">
            <p class="empty-text">Belum ada story — buat satu lewat tombol di atas.</p>
        </div>
    }
    else
    {
        <table class="stories-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Deadline</th>
                    <th class="col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var story in stories)
                {
                    var id = story.Id;
                    <tr @onclick="() => OpenDetail(id)">
                        <td>@story.Title</td>
                        <td><span class="chip @ChipClass(story.Status)">@story.Status</span></td>
                        <td><span class="chip @PriorityChipClass(story.Priority)">@story.Priority</span></td>
                        <td>@(story.Deadline?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td class="col-actions" @onclick:stopPropagation="true">
                            <button class="icon-btn" title="Edit" @onclick="() => OpenEdit(id)">
                                <iconify-icon icon="mdi:pencil-outline" width="20" height="20"></iconify-icon>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Story>? stories;
    private bool showForm = false;
    private CreateStoryRequest newStory = new();

    protected override async Task OnInitializedAsync()
    {
        stories = await StoryService.GetAllStoriesAsync();
    }

    private async Task CreateStory()
    {
        await StoryService.CreateStoryAsync(newStory);
        newStory = new();
        showForm = false;
        stories = await StoryService.GetAllStoriesAsync();
    }

    private void OpenDetail(Guid id) => Nav.NavigateTo($"/stories/{id}");

    private void OpenEdit(Guid id) => Nav.NavigateTo($"/stories/{id}/edit");

    private string ChipClass(StoryStatus status) => status switch
    {
        StoryStatus.Draft => "chip-draft",
        StoryStatus.InReview => "chip-review",
        StoryStatus.Approved => "chip-approved",
        StoryStatus.Published => "chip-published",
        StoryStatus.Killed => "chip-killed",
        _ => "chip-assigned"
    };

    private string PriorityChipClass(StoryPriority priority) => priority switch
    {
        StoryPriority.Normal => "chip-priority-normal",
        StoryPriority.High => "chip-priority-high",
        StoryPriority.Urgent => "chip-priority-urgent",
        StoryPriority.Breaking => "chip-priority-breaking",
        _ => "chip-priority-normal"
    };
}