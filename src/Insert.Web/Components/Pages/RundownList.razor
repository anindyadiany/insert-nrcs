@page "/rundown"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Insert.Application.Stories
@using Insert.Domain.Entities
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Producer")]
@inject RundownService RundownService
@inject NavigationManager Nav

<PageTitle>Rundown - INSERT NRCS</PageTitle>

<div class="story-page">
    <div class="stories-header">
        <h1 class="story-title">Rundown</h1>
        <button class="btn-primary" @onclick="() => showCreateForm = true">+ CREATE RUNDOWN</button>
    </div>

    @if (errorMessage is not null)
    {
        <div class="rundown-error">@errorMessage</div>
    }

    @if (showCreateForm)
    {
        <div class="card">
            <h5 class="card-title">New Rundown</h5>
            <EditForm Model="newRundown" OnValidSubmit="CreateRundown" FormName="new-rundown-form" class="form-stack">
                <div class="field-group">
                    <label>Title</label>
                    <InputText class="field-input" @bind-Value="newRundown.Title" />
                </div>
                <div class="field-group">
                    <label>Program</label>
                    <InputText class="field-input" @bind-Value="newRundown.Program" />
                </div>
                <div class="field-group">
                    <label>Air Date</label>
                    <InputDate class="field-input" @bind-Value="newRundown.AirDate" />
                </div>
                <div class="field-group">
                    <label>Start Time</label>
                    <input class="field-input" type="time" value="@newRundown.StartTime.ToString(@"hh\:mm")"
                           @onchange="OnStartTimeChanged" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-primary">Create</button>
                    <button type="button" class="btn-text" @onclick="() => showCreateForm = false">Cancel</button>
                </div>
            </EditForm>
        </div>
    }

    @if (rundowns is null)
    {
        <p class="loading">Loading...</p>
    }
    else if (!rundowns.Any())
    {
        <div class="card">
            <p class="empty-text">Belum ada rundown — buat satu lewat tombol di atas.</p>
        </div>
    }
    else
    {
        <table class="stories-table story-list-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Program</th>
                    <th>Air Date</th>
                    <th>Start Time</th>
                    <th>Items</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in rundowns)
                {
                    var id = entry.Rundown.Id;
                    <tr @onclick="() => OpenRundown(id)">
                        <td>@entry.Rundown.Title</td>
                        <td>@(entry.Rundown.Program ?? "-")</td>
                        <td>@entry.Rundown.AirDate.ToString("dd/MM/yyyy")</td>
                        <td>@FormatClock((int)entry.Rundown.StartTime.TotalSeconds)</td>
                        <td>@entry.ItemCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<RundownListItem>? rundowns;
    private bool showCreateForm = false;
    private string? errorMessage;
    private CreateRundownRequest newRundown = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        rundowns = await RundownService.GetAllRundownsAsync();
    }

    private async Task CreateRundown()
    {
        errorMessage = null;
        try
        {
            var userId = await GetCurrentUserIdAsync() ?? throw new InvalidOperationException("Not signed in.");
            var rundown = await RundownService.CreateRundownAsync(newRundown, userId);
            showCreateForm = false;
            newRundown = new();
            Nav.NavigateTo($"/rundown/{rundown.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out var ts))
            newRundown.StartTime = ts;
    }

    private void OpenRundown(Guid id) => Nav.NavigateTo($"/rundown/{id}");

    private static string FormatClock(int totalSeconds)
    {
        var normalized = ((totalSeconds % 86400) + 86400) % 86400;
        var span = TimeSpan.FromSeconds(normalized);
        return span.ToString(@"hh\:mm\:ss");
    }

    private async Task<Guid?> GetCurrentUserIdAsync()
    {
        var user = (await AuthState!).User;
        var idClaim = user.FindFirstValue(ClaimTypes.NameIdentifier);
        return Guid.TryParse(idClaim, out var userId) ? userId : null;
    }
}